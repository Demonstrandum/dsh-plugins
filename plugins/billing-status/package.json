{
  "name": "tali-billing-status",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral DSH billing evidence, durable request costs, and a compact status footer",
  "type": "module",
  "main": "index.js",
  "exports": { ".": "./index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
